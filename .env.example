# Copy to .env.local (or run `npm run setup`, which generates secrets for you).

# Setup key: asked for once on first run (/setup) to create the agency owner account.
# After that everyone signs in with their own email + password.
ADMIN_PASSWORD=change-me

# 32+ random characters. Signs admin sessions and encrypts API keys saved in Settings.
# Changing it logs you out and makes stored keys unreadable (re-enter them in Settings).
APP_SECRET=

# Optional: provider keys. Keys saved in Settings > AI Providers take priority over these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: public URL used in published pages and embed snippets (e.g. https://studio.example.com).
# Defaults to the URL of the incoming request.
PUBLIC_BASE_URL=

# Optional: SQLite file location (default ./data/caphub.db).
DATABASE_PATH=
